# Anthropic API key
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Email settings (IMAP – used by the CRM email reader)
EMAIL_ADDRESS=you@gmail.com
EMAIL_PASSWORD=your_app_password_here   # Gmail: use an App Password, not your main password
IMAP_HOST=imap.gmail.com
IMAP_PORT=993

# Optional: limit how many emails to scan per mailbox folder
MAX_EMAILS_PER_FOLDER=500

# ── Property Manager Research Agent (pm_agent.py) ──────────────────────────
# No extra config needed – the report is saved as a local HTML file
# in the directory where you run the script.
