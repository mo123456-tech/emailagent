# Anthropic API key
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Email settings (IMAP – used by the CRM email reader)
EMAIL_ADDRESS=you@gmail.com
EMAIL_PASSWORD=your_app_password_here   # Gmail: use an App Password, not your main password
IMAP_HOST=imap.gmail.com
IMAP_PORT=993

# Optional: limit how many emails to scan per mailbox folder
MAX_EMAILS_PER_FOLDER=500

# ── Property Manager Research Agent (pm_agent.py) ──────────────────────────

# Who should receive the research report email
REPORT_TO=you@gmail.com

# SMTP settings for sending the report
# Defaults to Gmail SMTP; EMAIL_ADDRESS + EMAIL_PASSWORD are reused if not set here
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# SMTP_USER=you@gmail.com        # optional override of EMAIL_ADDRESS
# SMTP_PASS=your_app_password    # optional override of EMAIL_PASSWORD
